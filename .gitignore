# Зависимости
node_modules/

# Локальная сборка папки публикации для проверки вложенного пути. На Pages её
# собирает workflow, в репозитории ей не место
_site/

# Сборка: бандл пересобирается командой `bun run build`
public/dist/

# Логи, скриншоты и отладочные скрипты. Папка удаляется целиком в любой момент
tmp/

# Локальные навыки агентов, к проекту отношения не имеют
.agents/
.kilo/

# Переменные окружения
.env
.env.*

# Системный мусор
.DS_Store
Thumbs.db
desktop.ini

# Редакторы и инструменты
.idea/
.vscode/
*.swp

